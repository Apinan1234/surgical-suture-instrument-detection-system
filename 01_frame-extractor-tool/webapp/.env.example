DATA_DIR=./webapp/data
MAX_UPLOAD_SIZE_MB=8192
MAX_TOTAL_UPLOAD_MB=51200
MAX_CONCURRENT_JOBS=2
MAX_FRAMES_ALL_MODE=20000

# REQUIRED. The single shared login password for the whole app. The server refuses to start without
# it: every API route — including model upload/load, which loads a pickle and can execute code — is
# otherwise open to anyone who can reach the port. Pick a long random value; copy this file to
# webapp/.env (already gitignored) and set it there. Never commit the real value.
APP_PASSWORD=

# Set to 1/true ONLY when the app is served over HTTPS (e.g. behind a TLS-terminating reverse proxy),
# so the session cookie is flagged Secure and never sent over plain HTTP. Leave unset for
# localhost/LAN plain-HTTP use, or the cookie is dropped and login silently never sticks.
SESSION_COOKIE_SECURE=

# How long a login lasts before it must be re-entered. Optional; defaults to 10.
SESSION_TTL_HOURS=10

# Set to false to run with NO login at all. Every route becomes open, including model loading,
# which executes a pickle - so only do this on an interface nobody else can reach, and set it back
# to true afterwards. Left unset, the login gate is on and APP_PASSWORD is required.
# REQUIRE_AUTH=true

# Optional. Set to 0 to accept UNRESTRICTED model loading (a .pt is a pickle and can execute code on
# load). Left unset, detector.py defaults it to "true" so ultralytics loads weights_only and rejects
# a malicious checkpoint. Only turn it off if you fully trust every .pt the app will ever load.
# ULTRALYTICS_SAFE_LOAD=

# Only read by ../train_roboflow_yolo.py (the standalone training script), not by the webapp server
# itself. Your Roboflow account's Private API Key — never commit the real value (this file is the
# .example template; the real webapp/.env is already gitignored).
ROBOFLOW_API_KEY=
