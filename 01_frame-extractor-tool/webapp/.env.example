DATA_DIR=./webapp/data
MAX_UPLOAD_SIZE_MB=8192
MAX_TOTAL_UPLOAD_MB=51200
MAX_CONCURRENT_JOBS=2
MAX_FRAMES_ALL_MODE=20000

# No login gate — the app is open to anyone who can reach the port. These are the abuse guardrails
# that stand in for it; lower them for a small/public box, raise them back for local/LAN-only use.

# Below this many free megabytes on DATA_DIR's filesystem, write-heavy routes (video/frame/model
# upload, extract) refuse new work with a clear 507 instead of failing mid-write.
MIN_FREE_DISK_MB=2048

# Per-IP throttle for routes that run CPU inference/OCR synchronously in the request handler (assist,
# ocr, detect, extract, export) and so aren't covered by MAX_CONCURRENT_JOBS.
RATE_LIMIT_EXPENSIVE_MAX=20
RATE_LIMIT_EXPENSIVE_WINDOW_SEC=300

# Ceiling (MB) on JSON request bodies, checked from Content-Length before the body is read. Video/
# frame/model uploads are multipart and have their own, larger limits above — not affected by this.
MAX_REQUEST_BODY_MB=64

# Optional. Set to 0 to accept UNRESTRICTED model loading (a .pt is a pickle and can execute code on
# load). Left unset, detector.py defaults it to "true" so ultralytics loads weights_only and rejects
# a malicious checkpoint. This is the real defence for the model-upload/model-load routes now that
# there's no login gate — do not turn it off on a public deployment.
# ULTRALYTICS_SAFE_LOAD=

# Only read by ../train_roboflow_yolo.py (the standalone training script), not by the webapp server
# itself. Your Roboflow account's Private API Key — never commit the real value (this file is the
# .example template; the real webapp/.env is already gitignored).
ROBOFLOW_API_KEY=
